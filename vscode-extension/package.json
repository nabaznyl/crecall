{
  "name": "crecall",
  "displayName": "Crecall - Session Recall & Memory (preview)",
  "description": "Never lose development context. Instant recall of clips and memories.",
  "version": "0.1.0d-6",
  "publisher": "crecall-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/crecall/crecall"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "crecall.createClip",
        "title": "Crecall: Create Clip"
      },
      {
        "command": "crecall.addMemory",
        "title": "Crecall: Add Memory"
      },
      {
        "command": "crecall.listClips",
        "title": "Crecall: List Clips"
      },
      {
        "command": "crecall.listMemories",
        "title": "Crecall: List Memories"
      },
      {
        "command": "crecall.showStatus",
        "title": "Crecall: Show Status"
      }
    ],
    "configuration": {
      "title": "Crecall",
      "properties": {
        "crecall.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Crecall API server URL"
        },
        "crecall.cliPath": {
          "type": "string",
          "default": "crecall",
          "description": "Path to crecall CLI binary"
        },
        "crecall.autoClipInterval": {
          "type": "number",
          "default": 300000,
          "description": "Auto-clip interval in milliseconds (default: 5 minutes)"
        },
        "crecall.enableAutoClip": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic clip creation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "dependencies": {
    "axios": "^1.7.2"
  }
}
