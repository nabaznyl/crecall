#!/usr/bin/env python3
"""
crecall crash recovery utility.

Checks for crashes and provides recovery options.
"""

import sys
import json
from pathlib import Path

# Add project root to path
sys.path.insert(0, str(Path(__file__).parent.parent))

try:
    from backend.app.services.crash_detector import CrashDetector
except ImportError:
    # Fallback: try importing with full package path
    from backend.app.services.crash_detector import CrashDetector


def main():
    """Main recovery flow."""
    print("crecall - Crash Recovery")
    print("=" * 60)
    
    # Check for crash
    crash_data = CrashDetector.check_for_crash()
    
    if not crash_data:
        print("✓ No crash detected. All sessions closed cleanly.")
        return 0
    
    # Display crash info
    print("\n⚠️  CRASH DETECTED\n")
    print(f"Session ID: {crash_data.get('session_id')}")
    print(f"Started at: {crash_data.get('started_at')}")
    print(f"Working directory: {crash_data.get('working_directory')}")
    
    if crash_data.get('last_clip_id'):
        print(f"Last clip: {crash_data.get('last_clip_id')}")
        print(f"Updated: {crash_data.get('updated_at', 'unknown')}")
    
    # Get recovery state
    recovery_state = CrashDetector.get_recovery_state()
    if recovery_state:
        print("\n📋 Recovery State Available:")
        print(f"  Last clip: {recovery_state.get('last_clip_id')}")
        print(f"  Updated: {recovery_state.get('updated_at')}")
    
    # Prompt for action
    print("\n" + "=" * 60)
    print("Recovery Options:")
    print("  1. Auto-restore from last clip (recommended)")
    print("  2. Show available clips")
    print("  3. Start fresh (clear crash marker)")
    print("  4. Exit without action")
    print("=" * 60)
    
    try:
        choice = input("\nChoice [1-4]: ").strip()
        
        if choice == "1":
            print("\n🔄 Restoring from last clip...")
            clip_id = crash_data.get('last_clip_id')
            if clip_id:
                import subprocess
                result = subprocess.run(
                    ['crecall', '-c', 'resume', str(clip_id)],
                    capture_output=True, text=True
                )
                if result.returncode == 0:
                    print("✓ Recovery complete!")
                    CrashDetector.clear_crash_marker()
                    return 0
                else:
                    print(f"✗ Restore failed: {result.stderr}")
                    return 1
            else:
                print("✗ No clip ID available for restore")
                return 1
        
        elif choice == "2":
            print("\n📂 Available clips:")
            import subprocess
            result = subprocess.run(
                ['crecall', '-c', 'list', '10'],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                print(result.stdout)
            else:
                print(f"Latest clip: {crash_data.get('last_clip_id')}")
                print("\nUse 'crecall --clip ls' for full list")
            return 0
        
        elif choice == "3":
            print("\n🗑️  Clearing crash marker...")
            CrashDetector.clear_crash_marker()
            print("✓ Crash marker cleared. Starting fresh.")
            return 0
        
        elif choice == "4":
            print("\nExiting without changes.")
            return 0
        
        else:
            print("Invalid choice. Exiting.")
            return 1
    
    except (EOFError, KeyboardInterrupt):
        print("\n\nCancelled.")
        return 1


if __name__ == "__main__":
    sys.exit(main())
