#!/usr/bin/env bash
set -euo pipefail
VERSION="0.1.0-dev-7"
DATA_HOME="$HOME/.recall_memory"
LOG_FILE="$DATA_HOME/recall.log"
STATE_FILE="$DATA_HOME/state.json"
MEMORY_FILE="$DATA_HOME/recall_memory.log"
TRANSCRIPTS_DIR="$DATA_HOME/transcripts"
PASSPHRASE_FILE="$DATA_HOME/passphrase"
API_URL="${CRECALL_API_URL:-http://localhost:8000/api}"

# Check if API is available
api_available() {
  curl -s -f "${API_URL/\/api/}/health" >/dev/null 2>&1
}

# Call API endpoint
api_call() {
  local method="$1"
  local endpoint="$2"
  shift 2
  curl -s -X "$method" "$API_URL$endpoint" "$@"
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

init_dirs() {
  mkdir -p "$DATA_HOME" "$TRANSCRIPTS_DIR"
  test -f "$STATE_FILE" || echo '{"status":"active"}' > "$STATE_FILE"
  test -f "$LOG_FILE" || touch "$LOG_FILE"
  test -f "$MEMORY_FILE" || touch "$MEMORY_FILE"
}

is_paused() {
  grep -q '"paused"' "$STATE_FILE" 2>/dev/null || return 1
}

set_state() {
  printf '{"status":"%s"}\n' "$1" > "$STATE_FILE"
}

ensure_passphrase() {
  test -n "${RECALL_PASSPHRASE:-}" && return 0
  if test -f "$PASSPHRASE_FILE"; then
    RECALL_PASSPHRASE=$(cat "$PASSPHRASE_FILE")
    export RECALL_PASSPHRASE
    return 0
  fi
  RECALL_PASSPHRASE=$(openssl rand -hex 32)
  printf '%s' "$RECALL_PASSPHRASE" > "$PASSPHRASE_FILE"
  chmod 600 "$PASSPHRASE_FILE"
  export RECALL_PASSPHRASE
}

save_checkpoint() {
  if is_paused && test -z "${FORCE:-}"; then
    echo '[crecall] Skipped save (paused).'
    return 0
  fi
  local note="${1:-Auto checkpoint}"
  local ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  local cwd=$(pwd)
  local ctx=$(command -v docker >/dev/null 2>&1 && docker context show 2>/dev/null || echo default)
  printf '{"timestamp":"%s","note":"%s","cwd":"%s","docker_context":"%s"}\n' \
    "$ts" "$(json_escape "$note")" "$(json_escape "$cwd")" "$(json_escape "$ctx")" >> "$LOG_FILE"
  echo "[crecall] Saved: $note"
}

summary() {
  echo "[crecall] Entries: $(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)"
  echo "[crecall] State: $(cat "$STATE_FILE" 2>/dev/null || echo unknown)"
  echo 'Recent:'
  tail -n 5 "$LOG_FILE" 2>/dev/null | sed 's/^/  /' || true
  echo 'Memory:'
  tail -n 5 "$MEMORY_FILE" 2>/dev/null | sed 's/^/  /' || true
}

transcript_plain() {
  local f="${1:-}"
  test -z "$f" && echo 'Provide file' && exit 1
  test -f "$f" || { echo 'Not found'; exit 1; }
  local ts=$(date -u +%Y%m%dT%H%M%SZ)
  local out="$TRANSCRIPTS_DIR/transcript-$ts.txt"
  cp "$f" "$out"
  echo "[crecall] Transcript: $out"
  set_state paused
  echo '[crecall] Paused.'
}

transcript_encrypt() {
  local f="${1:-}"
  test -z "$f" && echo 'Provide file' && exit 1
  test -f "$f" || { echo 'Not found'; exit 1; }
  ensure_passphrase
  local ts=$(date -u +%Y%m%dT%H%M%SZ)
  local out="$TRANSCRIPTS_DIR/transcript-$ts.txt.enc"
  openssl enc -aes-256-cbc -pbkdf2 -salt -in "$f" -out "$out" -pass env:RECALL_PASSPHRASE
  echo "[crecall] Encrypted: $out"
  set_state paused
  echo '[crecall] Paused.'
}

encrypt_file() {
  local f="${1:-}"
  test -z "$f" && echo 'Provide file' && exit 1
  test -f "$f" || { echo 'Not found'; exit 1; }
  ensure_passphrase
  openssl enc -aes-256-cbc -pbkdf2 -salt -in "$f" -out "$f.enc" -pass env:RECALL_PASSPHRASE
  echo "[crecall] Encrypted: $f.enc"
}

decrypt_file() {
  local f="${1:-}"
  test -z "$f" && echo 'Provide .enc file' && exit 1
  test -f "$f" || { echo 'Not found'; exit 1; }
  ensure_passphrase
  local out="${f%.enc}"
  openssl enc -d -aes-256-cbc -pbkdf2 -in "$f" -out "$out" -pass env:RECALL_PASSPHRASE
  echo "[crecall] Decrypted: $out"
}

memory_add() {
  local content="${1:-}"
  shift || true
  
  # Parse optional flags
  local category=""
  local importance="0"
  local tags=""
  
  while [ $# -gt 0 ]; do
    case "$1" in
      --category)
        category="$2"
        shift 2
        ;;
      --importance)
        importance="$2"
        shift 2
        ;;
      --tags)
        tags="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done
  
  test -z "$content" && echo 'Provide memory content' && exit 1
  
  # If API is available, use Python helper script
  if api_available; then
    local script_dir="$(dirname "$(readlink -f "$0")")"
    local cmd="python3 \"$script_dir/create_memory.py\" \"$content\""
    
    if [ -n "$category" ]; then
      cmd="$cmd --category \"$category\""
    fi
    
    if [ -n "$importance" ]; then
      cmd="$cmd --importance \"$importance\""
    fi
    
    if [ -n "$tags" ]; then
      cmd="$cmd --tags \"$tags\""
    fi
    
    eval "$cmd"
  else
    # Fallback to local file
    printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$content" >> "$MEMORY_FILE"
    echo '[crecall] Memory added locally (API not available)'
  fi
}

memory_list() {
  tail -n "${1:-20}" "$MEMORY_FILE" 2>/dev/null || true
}

memory_clear() {
  : > "$MEMORY_FILE"
  echo '[crecall] Memory cleared.'
}

# Clip management
clip_add() {
  local note="${1:-Manual clip}"
  if api_available; then
    local response=$(api_call POST /clips \
      -H "Content-Type: application/json" \
      -d "{\"session_id\":1,\"name\":\"$note\",\"is_auto\":false,\"content\":{\"type\":\"manual\",\"note\":\"$note\"}}")
    echo "[crecall] Clip created via API"
    echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"
  else
    echo "[crecall] API not available. Saving locally..."
    save_checkpoint "$note"
  fi
}

clip_list() {
  local limit="${1:-10}"
  if api_available; then
    echo "[crecall] Fetching clips from API..."
    local script_dir="$(dirname "$(readlink -f "$0")")"
    api_call GET "/clips/?limit=$limit" | python3 "$script_dir/format_clips.py"
  else
    echo "[crecall] API not available. Showing local checkpoints..."
    tail -n "$limit" "$LOG_FILE" 2>/dev/null | while read -r line; do
      echo "  $line"
    done
  fi
}

clip_resume() {
  local clip_id="${1:-}"
  if test -z "$clip_id"; then
    echo "[crecall] Usage: crecall clip resume <clip_id>"
    echo "[crecall] Use 'crecall clip list' to see available clips"
    return 1
  fi
  
  if api_available; then
    echo "[crecall] Restoring from clip: $clip_id"
    local start_time=$(date +%s%3N)
    local clip_data=$(api_call GET "/clips/$clip_id")
    local end_time=$(date +%s%3N)
    local duration=$((end_time - start_time))
    
    if echo "$clip_data" | grep -q "clip_id"; then
      echo "✓ Clip restored in ${duration}ms (instant recall!)"
      echo "$clip_data" | python3 -m json.tool 2>/dev/null || echo "$clip_data"
      
      # Extract working directory and cd to it if available
      local wd=$(echo "$clip_data" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("working_directory",""))' 2>/dev/null)
      if test -n "$wd" && test -d "$wd"; then
        echo "[crecall] Working directory: $wd"
        echo "[crecall] Run: cd $wd"
      fi
    else
      echo "✗ Clip not found: $clip_id"
      return 1
    fi
  else
    echo "[crecall] API not available. Cannot resume from clip."
    return 1
  fi
}

clip_clear() {
  if api_available; then
    echo "[crecall] Pruning clips via API..."
    api_call POST "/clips/prune/?keep_last=100" -H "Content-Type: application/json" -d '{}'
    echo "[crecall] Clips pruned (kept last 100)"
  else
    echo "[crecall] API not available. Use 'crecall cache prune --keep-last N'"
  fi
}

# Memory resume (load memory by ID)
memory_resume() {
  local memory_id="${1:-}"
  if test -z "$memory_id"; then
    echo "[crecall] Usage: crecall memory resume <id>"
    echo "[crecall] Use 'crecall memory list' to see available memories"
    return 1
  fi
  
  if api_available; then
    echo "[crecall] Loading memory: $memory_id"
    local memory_data=$(api_call GET "/memories/$memory_id/")
    
    if echo "$memory_data" | grep -q "content"; then
      echo "✓ Memory loaded"
      echo "$memory_data" | python3 -m json.tool 2>/dev/null || echo "$memory_data"
    else
      echo "✗ Memory not found: $memory_id"
      return 1
    fi
  else
    echo "[crecall] API not available. Showing local memories..."
    local line_num=$((memory_id))
    sed -n "${line_num}p" "$MEMORY_FILE" 2>/dev/null || echo "Memory not found"
  fi
}

# Memory search
memory_search() {
  local query="${1:-}"
  if test -z "$query"; then
    echo "[crecall] Usage: crecall memory search <query>"
    echo "[crecall] Example: crecall memory search 'authentication'"
    return 1
  fi
  
  if api_available; then
    echo "[crecall] Searching memories for: $query"
    local script_dir="$(dirname "$(readlink -f "$0")")"
    local search_data=$(api_call POST "/memories/search?query=$(echo "$query" | sed 's/ /%20/g')")
    
    if echo "$search_data" | grep -q "results"; then
      local count=$(echo "$search_data" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("count",0))' 2>/dev/null)
      echo "✓ Found $count results"
      echo ""
      echo "$search_data" | python3 "$script_dir/format_memory_search.py"
    else
      echo "✗ Search failed"
      return 1
    fi
  else
    echo "[crecall] API not available. Searching local memories..."
    grep -i "$query" "$MEMORY_FILE" 2>/dev/null || echo "No matches found"
  fi
}

resume() {
  if ! is_paused; then
    echo '[crecall] Already active.'
    return 0
  fi
  if test "${1:-}" = '--yes'; then
    set_state active
    echo '[crecall] Resumed.'
  else
    echo 'Use --yes to confirm resume'
  fi
}

manual_pause() {
  set_state paused
  echo '[crecall] Paused.'
}

cache_prune() {
  local keep_last="" dry=""
  while test $# -gt 0; do
    case "$1" in
      --keep-last) keep_last="$2"; shift 2;;
      --dry-run) dry=1; shift;;
      *) echo 'Unknown option'; exit 1;;
    esac
  done
  test -n "$keep_last" || { echo '[crecall] Specify --keep-last N'; return 1; }
  local tmp="$LOG_FILE.tmp"
  tail -n "$keep_last" "$LOG_FILE" > "$tmp" 2>/dev/null || true
  local o=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
  local n=$(wc -l < "$tmp" 2>/dev/null || echo 0)
  if test -n "$dry"; then
    echo "[crecall] Dry-run: $o -> $n"
    rm -f "$tmp"
    return 0
  fi
  mv "$tmp" "$LOG_FILE"
  echo "[crecall] Pruned: $o -> $n"
}

data_clear() {
  echo 'Type YES to confirm:'
  read -r ans
  test "$ans" = 'YES' || { echo 'Aborted.'; return 1; }
  rm -f "$LOG_FILE"
  rm -rf "$TRANSCRIPTS_DIR"
  mkdir -p "$TRANSCRIPTS_DIR"
  touch "$LOG_FILE"
  echo '[crecall] Data cleared.'
}

